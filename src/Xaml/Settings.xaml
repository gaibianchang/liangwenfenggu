<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="470">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8AFFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#66FFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,0,0,10"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5AFFFFFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
      <Setter Property="SelectionBrush" Value="#664C8DFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="11,0" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#994C8DFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="9" Background="#FF3D7BFF" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF5590FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2F66DB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D"/>
                <Setter Property="Foreground" Value="#80FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Foreground" Value="#D9FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="9" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D9FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="6" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="Check" Text="&#x2713;" FontFamily="Segoe UI Symbol" FontSize="11" Foreground="#FF6EA0FF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Background" Value="#334C8DFF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#8C4C8DFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#66FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="#FF4C8DFF" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="Transparent" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid>
              <Ellipse Width="14" Height="14" Fill="#FFFFFFFF"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#24FFFFFF" VerticalAlignment="Center" Margin="7,0"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumb}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Border Margin="12" CornerRadius="18" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#F2181D25"/>
        <GradientStop Offset="1" Color="#F20B0E13"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3AFFFFFF"/>
        <GradientStop Offset="1" Color="#10FFFFFF"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
    </Border.Effect>

    <StackPanel Margin="22,18,22,20">
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel>
          <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
          <TextBlock Text="梁文峰谷 · 桌面摆件" FontSize="11" Foreground="#59FFFFFF" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top"/>
      </Grid>

      <Border Height="1" Background="#1AFFFFFF" Margin="0,16,0,16"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="余额来源"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ModeNewApiButton" Style="{StaticResource BtnPrimary}" Content="NewAPI 中转站" MinWidth="124"/>
        <Button x:Name="ModeOfficialButton" Style="{StaticResource BtnGhost}" Content="官方" MinWidth="88" Margin="10,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="2,8,0,0" Text="查询中转站账户余额（GET /api/user/self）"/>

      <StackPanel x:Name="NewApiPanel" Margin="0,16,0,0">
        <TextBlock Style="{StaticResource FieldLabel}" Text="请求地址"/>
        <TextBox x:Name="BaseUrlBox" Style="{StaticResource InputBox}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" Text="填写中转站地址即可，例如 https://relay.example.com（末尾的 /v1 可省略）"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="访问令牌" Margin="2,16,0,7"/>
        <TextBox x:Name="TokenBox" Style="{StaticResource InputBox}"/>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="用户 ID"/>
            <TextBox x:Name="UserIdBox" Style="{StaticResource InputBox}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="额度换算（1 元 = quota）"/>
            <TextBox x:Name="QuotaBox" Style="{StaticResource InputBox}"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <StackPanel x:Name="OfficialPanel" Margin="0,16,0,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource FieldLabel}" Text="官方地址"/>
        <TextBox x:Name="OfficialUrlBox" Style="{StaticResource InputBox}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" Text="官方站点地址，例如 https://api.deepseek.com（也支持 SiliconFlow / OpenRouter / Novita）"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="官方 API Key" Margin="2,16,0,7"/>
        <TextBox x:Name="OfficialKeyBox" Style="{StaticResource InputBox}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" Text="在官方平台申请的 API Key，仅保存在本机 config.json"/>
      </StackPanel>

      <Border Height="1" Background="#1AFFFFFF" Margin="0,18,0,16"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="外观"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="缩放" FontSize="12.5" Foreground="#C6FFFFFF" VerticalAlignment="Center"/>
        <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource SlimSlider}" Minimum="0.6" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"/>
        <TextBlock x:Name="ScaleValue" Grid.Column="2" Text="1.00x" FontSize="12" Foreground="#8AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="88"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="背景不透明度" FontSize="12.5" Foreground="#C6FFFFFF" VerticalAlignment="Center"/>
        <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource SlimSlider}" Minimum="0.3" Maximum="1.0" SmallChange="0.02" LargeChange="0.1"/>
        <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="100%" FontSize="12" Foreground="#8AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <CheckBox x:Name="TopmostCheck" Style="{StaticResource DarkCheckBox}" Content="窗口置顶"/>
        <CheckBox x:Name="LockCheck" Style="{StaticResource DarkCheckBox}" Content="锁定位置" Margin="26,0,0,0"/>
      </StackPanel>

      <Border Height="1" Background="#1AFFFFFF" Margin="0,18,0,16"/>

      <TextBlock Style="{StaticResource SectionTitle}" Text="行为"/>
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource DarkCheckBox}" Content="开机自启动" VerticalAlignment="Center"/>
        <TextBlock Text="刷新间隔" FontSize="12.5" Foreground="#C6FFFFFF" VerticalAlignment="Center" Margin="30,0,10,0"/>
        <TextBox x:Name="RefreshBox" Style="{StaticResource InputBox}" Width="58" HorizontalContentAlignment="Center"/>
        <TextBlock Text="分钟" FontSize="12.5" Foreground="#8AFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>

      <Border x:Name="StatusPanel" Margin="0,16,0,0" CornerRadius="10" Background="#12FFFFFF" Padding="12,9" Visibility="Collapsed">
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#B3FFFFFF" TextWrapping="Wrap"/>
      </Border>

      <Grid Margin="0,18,0,0">
        <Button x:Name="TestButton" Style="{StaticResource BtnGhost}" Content="测试连接" HorizontalAlignment="Left" MinWidth="100"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource BtnGhost}" Content="取消" Margin="0,0,10,0"/>
          <Button x:Name="SaveButton" Style="{StaticResource BtnPrimary}" Content="保存"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Grid>
